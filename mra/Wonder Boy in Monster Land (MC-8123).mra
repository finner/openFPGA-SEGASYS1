<misterromdescription>
	<name>Wonder Boy in Monster Land (Japan New Ver., MC-8123, 317-0043)</name>
	<setname>wbml</setname>
	<rbf>segasys1</rbf>
	<mameversion>0229</mameversion>
	<year>1987</year>
	<manufacturer>Sega / Westone</manufacturer>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<!-- SYSMODE: System 2 only (MAME sys2x — NOT rowscroll; that's Choplifter) -->
	<rom index="1">
		<part>01</part>
	</rom>
	<switches default="FE,FF">
		<!-- SWA (game) — MAME wbml defaults -->
		<!--
		<dip name="Cabinet" bits="0" ids="Upright,Cocktail"/>
		-->
		<dip name="Demo Sounds" bits="1" ids="Off,On"/>
		<dip name="Lives" bits="2,3" ids="Free Play,3,5,4"/>
		<dip name="Bonus Life" bits="4" ids="50/150/250k,30/100/200k"/>
		<dip name="Difficulty" bits="5" ids="Hard,Easy"/>
		<dip name="Test Mode" bits="6" ids="On,Off"/>
		<!-- SWB (coins) -->
		<dip name="Coin A" bits="8,11" ids="1/1,1/1 2/3,1/1 4/5,1/1 5/6,2/1 4/3,2/1 5/3 6/4,2/3,4/1,3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
		<dip name="Coin B" bits="12,15" ids="1/1,1/1 2/3,1/1 4/5,1/1 5/6,2/1 4/3,2/1 5/3 6/4,2/3,4/1,3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
	</switches>
	<rom index="0" md5="none" zip="wbml.zip">
		<!-- soundcpu, size: 0x8000 -->
		<part crc="7a4ee585" name="epr-11037.126"/>

		<!-- maincpu, size: 0x18000 (encrypted; MAME maps 91/92 at 0x10000/0x18000) -->
		<part crc="bd3349e5" name="epr-11031a.90"/>
		<part crc="9d03bdb2" name="epr-11032.91"/>
		<part crc="7076905c" name="epr-11033.92"/>

		<!-- sprites, size: 0x20000 -->
		<part crc="af0b3972" name="epr-11028.87"/>
		<part crc="277d8f1d" name="epr-11027.86"/>
		<part crc="f05ffc76" name="epr-11030.89"/>
		<part crc="cedc9c61" name="epr-11029.88"/>

		<!-- tiles, size: 0x18000 -->
		<part crc="37a2077d" name="epr-11034.4"/>
		<part crc="cdf2a21b" name="epr-11035.5"/>
		<part crc="644687fa" name="epr-11036.6"/>

		<!-- lookup_proms, size: 0x0100 -->
		<part crc="648350b8" name="pr5317.37"/>

		<!-- color_proms, size: 0x0300 -->
		<part crc="27057298" name="pr11026.20"/>
		<part crc="41e4d86b" name="pr11025.14"/>
		<part crc="08d71954" name="pr11024.8"/>

		<!-- encryption_device - none (MC8123 key is separate) -->
		<part repeat="0x100">00</part>

		<!-- padding to $5a000 -->
		<part repeat="0x1b00">00</part>

		<!-- maincpu:key, size: 0x2000 -->
		<part crc="e354abfc" name="317-0043.key"/>
	</rom>
	<buttons names="Attack,Jump,-,-,-,Start 1P,Start 2P,Coin,Pause" default="A,B,X,R,L,Start,Select" count="2"/>
</misterromdescription>
