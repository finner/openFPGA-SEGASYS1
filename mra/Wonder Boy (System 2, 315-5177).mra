<misterromdescription>
	<name>Wonder Boy (System 2, set 1, 315-5177)</name>
	<setname>wboysys2</setname>
	<rbf>segasys1</rbf>
	<mameversion>0229</mameversion>
	<year>1986</year>
	<manufacturer>Escape (Sega license)</manufacturer>
	<players>2</players>
	<joystick>2-way</joystick>
	<rotation>horizontal</rotation>
	<!-- SYSMODE: System 2 only (MAME sys2 — NOT rowscroll) -->
	<rom index="1">
		<part>01</part>
	</rom>
	<switches default="6C,FF">
		<dip name="Lives" bits="2,3" ids="Free Play,5,4,3"/>
		<dip name="Bonus Life" bits="4" ids="30k 120k 210k 300k,30k 100k 170k 240k"/>
		<dip name="Allow Continue" bits="5" ids="No,Yes"/>
		<dip name="Difficulty" bits="6" ids="Hard,Easy"/>
		<dip name="Coin A" bits="8,11" ids="1/1,1/1 2/3,1/1 4/5,1/1 5/6,2/1 4/3,2/1 5/3 6/4,2/3,4/1,3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
		<dip name="Coin B" bits="12,15" ids="1/1,1/1 2/3,1/1 4/5,1/1 5/6,2/1 4/3,2/1 5/3 6/4,2/3,4/1,3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
	</switches>
	<rom index="0" md5="none" zip="wboysys2.zip|wboy.zip">
		<!-- soundcpu, size: 0x8000 -->
		<part crc="99334b3c" name="epr-7583.126"/>

		<!-- maincpu, size: 0x18000 (MAME gap at 0x8000) -->
		<part crc="d69927a5" name="epr-7580.90"/>
		<part crc="8a6f4b00" name="epr-7579.91"/>
		<part repeat="0x8000">ff</part>

		<!-- sprites, size: 0x20000 (64KB used + pad) -->
		<part crc="6ff1637f" name="epr-7578.87"/>
		<part crc="58b3705e" name="epr-7577.86"/>
		<part repeat="0x10000">00</part>

		<!-- tiles, size: 0x18000 -->
		<part crc="d95565fd" name="epr-7581.4"/>
		<part crc="560cbac0" name="epr-7582.5"/>
		<part crc="bd36df03" name="epr-7607.6"/>

		<!-- lookup_proms, size: 0x0100 -->
		<part crc="648350b8" name="pr-5317.76"/>

		<!-- color_proms, size: 0x0300 -->
		<part crc="8eee0f72" name="pr-7345.ic20"/>
		<part crc="3e7babd7" name="pr-7344.ic14"/>
		<part crc="371c44a6" name="pr-7343.ic8"/>

		<!-- encryption_device: 315-5177 (same table as System 1 Wonder Boy) -->
		<part>
			04 54 51 15 40 44 01 51 55 10 44 41 05 55 50 14
			41 45 00 50 54 11 45 40 04 54 51 15 40 44 01 51
			55 10 44 41 05 55 50 14 41 45 00 50 54 11 45 40
			04 54 51 15 40 44 01 51 55 10 44 41 05 55 50 14
			04 54 51 15 40 44 01 51 55 10 44 41 05 55 50 14
			41 45 00 50 54 11 45 40 04 54 51 15 40 44 01 51
			55 10 44 41 05 55 50 14 41 45 00 50 54 11 45 40
			04 54 51 15 40 44 01 51 55 10 44 41 05 55 50 14

			00 00 00 00 01 01 01 01 01 02 02 02 02 02 03 03
			03 03 04 04 04 04 04 05 05 05 05 05 06 06 06 06
			06 07 07 07 07 07 08 08 08 08 09 09 09 09 09 0a
			0a 0a 0a 0a 0b 0b 0b 0b 0b 0c 0c 0c 0c 0c 0d 0d
			08 08 08 08 09 09 09 09 09 0a 0a 0a 0a 0a 0b 0b
			0b 0b 0c 0c 0c 0c 0c 0d 0d 0d 0d 0d 0e 0e 0e 0e
			0e 0f 0f 0f 0f 0f 10 10 10 10 11 11 11 11 11 12
			12 12 12 12 13 13 13 13 13 14 14 14 14 14 15 15
		</part>
	</rom>
	<buttons names="Jump,Fire,-,-,-,Start 1P,Start 2P,Coin,Pause" default="A,B,X,R,L,Start,Select" count="2"/>
</misterromdescription>
